@startuml
' Diagrama de classes UML do código Java entregue - APS Grupo 12
skinparam backgroundColor #FFFFFF
skinparam classBackgroundColor #F8F5FF
skinparam classBorderColor #7C3AED
skinparam arrowColor #7C3AED
skinparam packageBorderColor #C4B5FD
skinparam packageBackgroundColor #FAF5FF
skinparam shadowing false
hide empty methods

package "Domínio" {
  enum Perfil { GERENTE; VENDEDOR }
  enum EstadoVenda { PENDENTE; CONFIRMADA; CANCELADA }
  enum TipoMovimentacao { ENTRADA_REPOSICAO; SAIDA_VENDA; ENTRADA_DEVOLUCAO }
  class Produto <<record>> {
    - id: String
    - nome: String
    - precoCentavos: long
    - estoque: int
    - estoqueMinimo: int
    + comEstoque(saldo: int): Produto
    + emAlerta(): boolean
  }
  class ItemVenda <<record>> {
    - produtoId: String
    - quantidade: int
    - precoUnitarioCentavos: long
    - descontoCentavos: long
    + brutoCentavos(): long
    + liquidoCentavos(): long
    + restituiAte(qtd: int): long
  }
  class Venda <<record>> {
    - id: String
    - estado: EstadoVenda
    - itens: List<ItemVenda>
    - subtotalCentavos: long
    - descontoCentavos: long
    - totalCentavos: long
    + comEstado(novo: EstadoVenda): Venda
    + item(produtoId: String): ItemVenda
  }
  class Devolucao <<record>> {
    - id: String
    - vendaId: String
    - produtoId: String
    - quantidade: int
    - reembolsoCentavos: long
  }
  class Movimentacao <<record>> {
    - id: String
    - operacaoId: String
    - produtoId: String
    - tipo: TipoMovimentacao
    - quantidade: int
  }
  Venda "1" *-- "1..*" ItemVenda
  Venda "1" --> "1" EstadoVenda
  Venda "1" <-- "0..*" Devolucao : refere-se a
  Produto "1" <-- "0..*" ItemVenda : produtoId
  Produto "1" <-- "0..*" Movimentacao : produtoId
}
package "Serviços" {
  class ServicoLoja {
    - repositorio: Repositorio
    - observadores: List<ObservadorEstoque>
    + cadastrarProduto(perfil, produto): void
    + abrirVenda(perfil, id, itens, politica): Venda
    + confirmarVenda(perfil, id): Venda
    + cancelarVendaPendente(perfil, id): Venda
    + devolver(perfil, id, vendaId, produtoId, quantidade): Devolucao
    + reporEstoque(perfil, produtoId, quantidade, lancamentoId): Produto
    + consultarReceitaLiquidaCentavos(perfil): long
    + consultarProdutosEmAlerta(perfil): List<Produto>
  }
  class LojaFacade <<Facade>> {
    - servico: ServicoLoja
    - exportador: ExportadorRelatorio
    + abrirVenda(...): Venda
    + confirmar(...): Venda
    + devolver(...): Devolucao
    + estoque(...): List<Produto>
    + relatorio(...): String
  }
  LojaFacade --> ServicoLoja
}
package "Serviços de gestão" {
  class ServicoCadastros {
    + salvarCliente(perfil, cliente, novo): Cliente
    + excluirCliente(perfil, id): void
    + salvarFornecedor(...): Fornecedor
    + salvarCategoria(...): Categoria
    + cadastrarUsuario(perfil, email, nome, perfil, senha): Usuario
    + alterarAtivo(perfil, email, ativo): Usuario
  }
  class ServicoFinanceiro {
    - relogio: Clock
    + lancarConta(...): ContaFinanceira
    + quitar(perfil, id): ContaFinanceira
    + definirMeta(perfil, valor): long
  }
  class ServicoRelatorios {
    - relogio: Clock
    + painel(perfil): Painel
    + resumo(perfil, periodo): Resumo
    + vendasPorMes(perfil, ano): long[]
    + compras(perfil, periodo): ResumoCompras
  }
  LojaFacade --> ServicoCadastros
  LojaFacade --> ServicoFinanceiro
  LojaFacade --> ServicoRelatorios
}
package "Domínio (gestão)" {
  class Cliente <<record>> { - id; - nome; - telefone; - email }
  class Fornecedor <<record>> { - id; - nome; - documento; - telefone }
  class Categoria <<record>> { - id; - nome }
  class Compra <<record>> { - id; - fornecedorId; - produtoId; - quantidade: int; - custoUnitarioCentavos: long; - data }
  class ContaFinanceira <<record>> {
    - tipo: TipoConta
    - situacao: SituacaoConta
    - valorCentavos: long
    + quitar(data): ContaFinanceira
    + cancelar(): ContaFinanceira
  }
  enum FormaPagamento { DINHEIRO; PIX; CARTAO_CREDITO; CARTAO_DEBITO }
  Venda "0..*" --> "0..1" Cliente : clienteId
  Venda --> FormaPagamento
  Compra "0..*" --> "1" Fornecedor
  Produto "0..*" --> "1" Categoria
}
package "Persistência" {
  interface Repositorio {
    + consultar(funcao): T
    + transacionar(funcao): T
  }
  class RepositorioCsvAtomico {
    - arquivo: Path
    - trava: Path
    - interceptor: InterceptorCommit
    - ler(): EstadoDados
    - gravarAtomico(dados): void
    + restaurarDemo(): void
  }
  class EstadoDados {
    + produtos: Map<String,Produto>
    + vendas: Map<String,Venda>
    + devolucoes: Map<String,Devolucao>
    + movimentacoes: Map<String,Movimentacao>
    + copiar(): EstadoDados
  }
  class RepositorioMemoria
  Repositorio <|.. RepositorioCsvAtomico
  Repositorio <|.. RepositorioMemoria
  RepositorioCsvAtomico --> EstadoDados
  EstadoDados o-- "0..*" Produto
  EstadoDados o-- "0..*" Venda
  EstadoDados o-- "0..*" Devolucao
  EstadoDados o-- "0..*" Movimentacao
}
package "Strategy (comportamental)" {
  interface PoliticaDesconto <<Strategy>> {
    + descontoEmCentavos(subtotal: long): long
    + nome(): String
  }
  class DescontoPercentual
  class DescontoFixo
  class DescontoPorFaixa <<extensão>> {
    - faixas: NavigableMap<Long,BigDecimal>
    + {static} padraoDaLoja(): DescontoPorFaixa
  }
  PoliticaDesconto <|.. DescontoPercentual
  PoliticaDesconto <|.. DescontoFixo
  PoliticaDesconto <|.. DescontoPorFaixa
}
package "Factory Method (criação)" {
  abstract class CriadorPoliticaDesconto <<Creator>> {
    + criar(parametro: String): PoliticaDesconto {final}
    # {abstract} fabricar(parametro: String): PoliticaDesconto
    + {abstract} descricao(): String
    + exigeParametro(): boolean
  }
  class CriadorDescontoPercentual
  class CriadorDescontoFixo
  class CriadorDescontoPorFaixa
  class CatalogoDescontos {
    - criadores: List<CriadorPoliticaDesconto>
    + {static} padrao(): CatalogoDescontos
  }
  CriadorPoliticaDesconto <|-- CriadorDescontoPercentual
  CriadorPoliticaDesconto <|-- CriadorDescontoFixo
  CriadorPoliticaDesconto <|-- CriadorDescontoPorFaixa
  CatalogoDescontos o-- "1..*" CriadorPoliticaDesconto
  CriadorPoliticaDesconto ..> PoliticaDesconto : cria
}
package "Segurança" {
  class Usuario <<record>> {
    - email: String
    - nome: String
    - perfil: Perfil
    - hashSenha: String
  }
  interface ContasDeUsuario { + buscarPorEmail(email): Optional<Usuario> }
  class ContasDemo
  class ContasPersistidas
  ContasDeUsuario <|.. ContasPersistidas
  class ServicoAutenticacao {
    - contas: ContasDeUsuario
    + entrar(email, senha): Usuario
  }
  ContasDeUsuario <|.. ContasDemo
  ServicoAutenticacao --> ContasDeUsuario
  ServicoAutenticacao ..> Usuario
}
package "Interface (View/Controller)" {
  class JanelaLogin
  class JanelaPrincipal
  abstract class Pagina {
    # ctx: Contexto
    ~ {abstract} atualizar(): void
  }
  class PaginaPdv
  class PaginaDashboard
  class PaginaHistorico
  class PaginaRelatorios
  abstract class "PaginaListaDetalhe<T>" as PLD
  class PaginaClientes
  class PaginaProdutos
  class ConsoleView
  Pagina <|-- PaginaPdv
  Pagina <|-- PaginaDashboard
  Pagina <|-- PaginaHistorico
  Pagina <|-- PaginaRelatorios
  Pagina <|-- PLD
  PLD <|-- PaginaClientes
  PLD <|-- PaginaProdutos
  JanelaPrincipal o-- "1..11" Pagina
  JanelaLogin --> ServicoAutenticacao
  JanelaLogin ..> JanelaPrincipal : abre
  PaginaPdv --> CatalogoDescontos
  ConsoleView --> CatalogoDescontos
}
package "Observer (comportamental)" {
  interface ObservadorEstoque <<Observer>> { + aoAlterarEstoque(evento): void }
  class AlertaEstoqueMinimo
  class EventoEstoque <<record>>
  ObservadorEstoque <|.. AlertaEstoqueMinimo
  ObservadorEstoque ..> EventoEstoque
}
package "Adapter (estrutural)" {
  interface ExportadorRelatorio { + exportar(dados: EstadoDados): String }
  class AdaptadorRelatorio <<Adapter>>
  class ExportadorAntigo <<simulado>> { + arquivo(linhas): String }
  ExportadorRelatorio <|.. AdaptadorRelatorio
  AdaptadorRelatorio --> ExportadorAntigo
}
class App <<montagem>>
ServicoLoja --> Repositorio : injeção
ServicoLoja --> PoliticaDesconto : usa
ServicoLoja --> "0..*" ObservadorEstoque : notifica
LojaFacade --> ExportadorRelatorio : usa
App ..> LojaFacade : cria
App ..> JanelaLogin : inicia
App ..> ConsoleView : inicia (--console)
Pagina --> LojaFacade : usa
ConsoleView --> LojaFacade : usa
ServicoLoja ..> Venda
ServicoLoja ..> Devolucao
ServicoLoja ..> Produto
@enduml
